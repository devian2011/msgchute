{
    "swagger": "2.0",
    "info": {
        "description": "HTTP API for send any messages",
        "title": "Notification service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/admin/v1/message": {
            "get": {
                "description": "Retrieves a paginated list of messages filtered by status, IDs, recipients, senders, codes, or transports.",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin-messages"
                ],
                "summary": "List and filter messages",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page number for pagination",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Number of items per page",
                        "name": "per_page",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Field to sort by",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort order direction (asc/desc)",
                        "name": "order",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Filter by message status array",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Filter by message UUID array",
                        "name": "ids",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Filter by recipient array",
                        "name": "recipient",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Filter by sender ID array",
                        "name": "sender_ids",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Filter by message code array",
                        "name": "code",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Filter by transport type array",
                        "name": "transport",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of filtered messages with pagination metadata",
                        "schema": {
                            "$ref": "#/definitions/internal_io_web_endpoint_admin.MessageFinderResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters or form parsing failure",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error while searching for records",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    }
                }
            }
        },
        "/api/admin/v1/message/{id}": {
            "get": {
                "description": "Retrieves full message details for a specific record via its UUID.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin-messages"
                ],
                "summary": "Get message by ID",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Unique message UUID identifier",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detailed structural message metadata",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_internal_dto.FullMessageInfo"
                        }
                    },
                    "400": {
                        "description": "Invalid or malformed UUID parameter format",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error or record resolution failure",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    }
                }
            }
        },
        "/api/admin/v1/template": {
            "get": {
                "description": "Retrieves a paginated collection of message templates filtered by system code arrays or full-text query matches.",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin-templates"
                ],
                "summary": "List and filter templates",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page index parameter",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Page item capacity limit",
                        "name": "per_page",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Target field criteria for ordering records",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Ascending or descending order selection (asc/desc)",
                        "name": "order",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Filter metrics by unique message system code tokens",
                        "name": "code",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Generic phrase match expression matching structural text",
                        "name": "search",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Key-value dictionary mapping matching code IDs to schema definitions",
                        "schema": {
                            "$ref": "#/definitions/internal_io_web_endpoint_admin.TemplateFinderResult"
                        }
                    },
                    "400": {
                        "description": "Query validation or structured query parameter parse errors",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    },
                    "500": {
                        "description": "Internal catalog resolution context errors",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates and stores a completely new message configuration blueprint in the repository.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin-templates"
                ],
                "summary": "Create a template",
                "parameters": [
                    {
                        "description": "Structural definition specification metrics payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_internal_dto.Template"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Newly registered template model confirmation metadata",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_internal_dto.Template"
                        }
                    },
                    "400": {
                        "description": "Corrupted JSON payload body formatting syntax exception",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    },
                    "500": {
                        "description": "Persistence system errors encountered storing details",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    }
                }
            }
        },
        "/api/admin/v1/template/{code}": {
            "put": {
                "description": "Modifies variables, subjects, or raw body layouts of an existing layout found by its explicit target code route component.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin-templates"
                ],
                "summary": "Update a template",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Target identifying tracking code token context",
                        "name": "code",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Updatable structural model fields",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_internal_dto.Template"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Refreshed schema specifications entry state details",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_internal_dto.Template"
                        }
                    },
                    "400": {
                        "description": "Invalid path payload reference parameters or corrupt body markup values",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    },
                    "500": {
                        "description": "Database or engine exceptions processing modified models",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/preview": {
            "post": {
                "description": "Accepts a raw message template along with dynamic parameters, renders them, and returns the final subject and body preview.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "Preview message",
                "parameters": [
                    {
                        "description": "Message template definition and rendering context",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_io_web_endpoint_public.PreviewMessageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Template successfully rendered",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_internal_dto.MessagePreview"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON payload or syntax error",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error during template rendering",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/send": {
            "post": {
                "description": "Accepts a message payload, processes its delivery, and registers the tracking task.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "messages"
                ],
                "summary": "Send message",
                "parameters": [
                    {
                        "description": "Message details to be processed and sent",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_internal_dto.Message"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Message processed and delivery task created successfully",
                        "schema": {
                            "$ref": "#/definitions/internal_io_web_endpoint_public.SenderResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON payload or structural error",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    },
                    "500": {
                        "description": "Internal server error during processing or delivery dispatch",
                        "schema": {
                            "$ref": "#/definitions/github_com_devian2011_msgchute_pkg_http_response.Response"
                        }
                    }
                }
            }
        }
    },
